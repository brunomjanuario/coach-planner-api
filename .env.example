# Copy to .env and adjust as needed. .env is gitignored — never commit real secrets.

POSTGRES_DB=coachplanner
POSTGRES_USER=coachplanner
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Only needed for `docker compose --profile full up` (the api service, T49).
# Generate a real one for anything beyond local testing: openssl rand -base64 32
JWT_SECRET=dev-only-insecure-jwt-secret-please-override-me-32bytes+
